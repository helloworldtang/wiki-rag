# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会提交）

# DeepSeek API密钥（默认LLM），获取：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxx

# ---- 以下均为可选项，删掉即用默认值 ----

# DeepSeek API地址（自建代理/中转时改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM模型名
# WIKI_LLM_MODEL=deepseek-chat

# Embedding模型名（须为本地Ollama已拉取的模型）
# WIKI_EMBED_MODEL=nomic-embed-text:latest

# 设为1时LLM也走本地Ollama（Embedding始终走本地），完全离线可用
# WIKI_USE_LOCAL_LLM=1
# WIKI_LOCAL_MODEL=deepseek-r1:1.5b
